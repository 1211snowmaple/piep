<?xml version="1.0" encoding="utf-8"?>
<!--
  EPUB 2 の目次。EPUB 3 では nav.xhtml が正式だが、Send to Kindle をはじめ
  古い経路の取り込みは今も NCX を探す。両方入れておくのが最も通りがよい。
-->
<ncx xmlns="http://www.daisy.org/z3986/2005/ncx/" version="2005-1" xml:lang="{{ settings.language }}">
    <head>
        <meta name="dtb:uid" content="{{ identifier }}" />
        <meta name="dtb:depth" content="{{ depth }}" />
        <meta name="dtb:totalPageCount" content="0" />
        <meta name="dtb:maxPageNumber" content="0" />
    </head>
    <docTitle>
        <text>{{ core.name }}</text>
    </docTitle>
    <docAuthor>
        <text>{{ core.author.name }}</text>
    </docAuthor>
    <navMap>
        {%- for entry in entries %}
        <navPoint id="nav-{{ entry.id }}" playOrder="{{ entry.order }}">
            <navLabel>
                <text>{{ entry.title }}</text>
            </navLabel>
            <content src="{{ entry.href }}" />
            {%- for child in entry.children %}
            <navPoint id="nav-{{ child.id }}" playOrder="{{ child.order }}">
                <navLabel>
                    <text>{{ child.title }}</text>
                </navLabel>
                <content src="{{ child.href }}" />
            </navPoint>
            {%- endfor %}
        </navPoint>
        {%- endfor %}
    </navMap>
</ncx>
