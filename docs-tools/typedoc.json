{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "../src"
  ],
  "entryPointStrategy": "expand",
  "exclude": [
    "../src/**/*.test.ts",
    "../src/**/*.test.tsx",
    "../src/test/**",
    "../src/mocks/**"
  ],
  "tsconfig": "./tsconfig.docs.json",
  "out": "./site/public/frontend",
  "skipErrorChecking": false,
  "readme": "none",
  "githubPages": false,
  "excludePrivate": false,
  "excludeInternal": true,
  "sort": [
    "source-order"
  ],
  "excludeExternals": true,
  "validation": {
    "notExported": false,
    "invalidLink": false,
    "notDocumented": false
  },
  "name": "piep フロントエンド"
}
