{
  /* 視覚回帰と窓のスモークテスト、それに設定ファイルそのもの。
     `tsconfig.json` の `include` は `["src"]` だけなので、ここは誰にも
     型検査されていなかった。Playwright は esbuild で型を剥がすだけなので、
     走らせても型の誤りは出ない - 壊れていることに気づく機会が無い。 */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true
  },
  "include": ["e2e", "playwright.config.ts", "vitest.config.ts"],
  "references": []
}
