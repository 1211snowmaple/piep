{
  "name": "piep",
  "private": true,
  "version": "0.26.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "oxlint --deny-warnings src e2e",
